    <% topics.forEach(topic => {
      const slug = topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

      // Mapping for known quiz files
      const quizMap = {
        "indian-geography-general-introduction-area": "area"
        // Add more custom mappings here as needed
      };

      const quizFile = quizMap[slug] || slug;
    %>
      <div class="topic-item">
        <span><%= topic %></span>
        <a href="/upsc/<%= quizFile %>"><button class="btn">Take Quiz</button></a>
      </div>
    <% }) %>

  </div>
</body>
</html>
