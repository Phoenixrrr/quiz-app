<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Static Quizzes – UPSC Topics</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    h1 { margin-bottom: 30px; }
    .topic-list { display: flex; flex-direction: column; gap: 10px; max-width: 800px; margin: auto; }
    .topic-item { display: flex; justify-content: space-between; align-items: center; background: #f2f2f2; padding: 12px 20px; border-radius: 6px; }
    .topic-item:hover { background: #e0e0e0; }
    .btn { padding: 6px 12px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .btn:hover { background-color: #45a049; }
  </style>
</head>
<body>
  <h1>Geography</h1>
  <div class="topic-list">

    <% const topics = [
      "Indian Geography - General Introduction - Area",
      "Latitudinal Expansion",
      "India and the Tropic of Cancer",
      "Standard Time",
      "Extreme Points",
      "Bordering Countries",
      "Physical Division - Natural Region of India",
      "Northern Mountainous Region",
      "Mountain Ranges and Hills of South and Central India",
      "Mountain Peaks",
      "Valleys",
      "Passes",
      "Snow Lines and Glaciers",
      "Plateaus",
      "Coastal Region",
      "Indian Coastline",
      "Eastern and Western Coast",
      "Islands - Bay of Bengal",
      "Islands - Arabian Sea",
      "States of India",
      "Union Territories",
      "Species/Tribes",
      "Languages",
      "Drainage System - Ganga",
      "Drainage System - Brahmaputra",
      "Other Rivers",
      "Cities Located on River Banks",
      "Waterfalls and Lakes",
      "Climate - Monsoon",
